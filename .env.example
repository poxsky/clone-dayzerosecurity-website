# ── Database (required) ──────────────────────────────────────────────
# PostgreSQL connection string used by the app and by drizzle-kit.
#
#  Neon (recommended free tier) — https://neon.tech
#    Project dashboard → Connection Details → "Pooled connection",
#    then append ?sslmode=require
#    e.g. postgresql://user:pass@ep-name-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
#  Supabase — https://supabase.com
#    Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
#    e.g. postgresql://postgres.refxxxx:pass@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Quote-form email notifications (optional) ────────────────────────
# If RESEND_API_KEY is set, every new quote request is also emailed to
# the team (in addition to being stored in the database).
#
# 1. Create a free account at https://resend.com
# 2. Verify the 0daysecurity.tech domain (Domains → Add Domain)
# 3. Create an API key and set the variables below.
#
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# QUOTE_NOTIFY_FROM=0DAY Research Team <no-reply@0daysecurity.tech>
# QUOTE_NOTIFY_EMAIL=anmol@0daysecurity.tech
